+    void FillBlock(CBlockIndex& block, /*const*/ CBlockIndex* prevBlock, const uint256& hash)
+    {
+        if (prevBlock)
+        {
+            block.nHeight = prevBlock->nHeight + 1;
+            block.pprev = prevBlock;
+        }
+        else
+        {
+            block.nHeight = 0;
+        }
+
+        block.phashBlock = &hash;
+        block.nTime = GetTime();
+        block.BuildSkip();
+    }
