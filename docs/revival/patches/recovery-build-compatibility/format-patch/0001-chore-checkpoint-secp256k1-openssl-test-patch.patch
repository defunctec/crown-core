+
+bool FindTransactionInBlock(const CBlock& block, const uint256& txToFind, CTransaction &tx)
+{
+    for (int i = 0; i < (int) block.vtx.size(); i++) {
+        const CTransaction &txi = block.vtx[i];
+        if (txi.GetHash() == txToFind) {
+            tx = txi;
+            return true;
+        }
+    }
+    return false;
+}
