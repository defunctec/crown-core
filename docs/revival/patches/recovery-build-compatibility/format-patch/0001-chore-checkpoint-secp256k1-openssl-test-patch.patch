+boost::filesystem::path static StartupShortcutPath()
+{
+    return GetSpecialFolderPath(CSIDL_STARTUP) / "Crown.lnk";
+}
+
+bool GetStartOnSystemStartup()
+{
+    // check for Crown.lnk
+    return boost::filesystem::exists(StartupShortcutPath());
