+    QDialog(parent),
+    ui(new Ui::ReceiveRequestDialog),
+    model(0)
+{
+    ui->setupUi(this);
+
+#ifndef USE_QRCODE
+    ui->btnSaveAs->setVisible(false);
+    ui->lblQRCode->setVisible(false);
+#endif
+
+    connect(ui->btnSaveAs, SIGNAL(clicked()), ui->lblQRCode, SLOT(saveImage()));
+}
