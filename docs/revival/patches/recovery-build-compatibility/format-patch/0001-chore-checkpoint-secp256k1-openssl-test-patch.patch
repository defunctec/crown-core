+#include "walletmodel.h"
+
+#include "addresstablemodel.h"
+#include "guiconstants.h"
+#include "recentrequeststablemodel.h"
+#include "transactiontablemodel.h"
+
+#include "base58.h"
+#include "db.h"
+#include "keystore.h"
+#include "main.h"
+#include "sync.h"
+#include "ui_interface.h"
