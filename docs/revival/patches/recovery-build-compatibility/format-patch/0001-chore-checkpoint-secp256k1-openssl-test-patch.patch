+}
+
+bool DateTableWidgetItem::operator< ( const QTableWidgetItem & other ) const
+{
+    const DateTableWidgetItem &other_cast = static_cast<const DateTableWidgetItem &>(other);
+    return date < other_cast.date;
+}
