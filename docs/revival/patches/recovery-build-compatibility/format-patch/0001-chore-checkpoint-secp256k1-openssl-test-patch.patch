+RPCConsole::RPCConsole(QWidget *parent) :
+    QDialog(parent),
+    ui(new Ui::RPCConsole),
+    clientModel(0),
+    historyPtr(0),
+    cachedNodeid(-1)
+{
+    ui->setupUi(this);
