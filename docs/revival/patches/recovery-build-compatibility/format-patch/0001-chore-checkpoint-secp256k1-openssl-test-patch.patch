+bool CMasternodeMan::Add(const CMasternode &mn)
+{
+    LOCK(cs);
+
+    if (!mn.IsEnabled())
+        return false;
+
+    CMasternode *pmn = Find(mn.vin);
+    if (pmn == NULL)
+    {
+        LogPrint("masternode", "CMasternodeMan: Adding new Masternode %s - %i now\n", mn.addr.ToString(), size() + 1);
+        vMasternodes.push_back(mn);
+        return true;
+    }
+
+    return false;
+}
