+QString UpdateDialog::getOSString(boost::optional<Updater::OS> os)
+{
+    QString osString = "Unknown";
+    if (os) {
+        switch(os.get()) {
+            case Updater::LINUX_32:
+                osString = "Linux 32";
+                break;
+            case Updater::LINUX_64:
+                osString = "Linux 64";
+                break;
+            case Updater::WINDOWS_32:
+                osString = "Windows 32";
+                break;
+            case Updater::WINDOWS_64:
+                osString = "Windows 64";
+                break;
+            case Updater::MAC_OS:
+                osString = "Mac OS";
+                break;
+            default:
+                osString = "Unknown";
+        }
+    }
+    return osString;
+}
