+
+QT_BEGIN_NAMESPACE
+class QIcon;
+class QMenu;
+class QWidget;
+QT_END_NAMESPACE
+
+/** Macintosh-specific dock icon handler.
+ */
+class MacDockIconHandler : public QObject
+{
