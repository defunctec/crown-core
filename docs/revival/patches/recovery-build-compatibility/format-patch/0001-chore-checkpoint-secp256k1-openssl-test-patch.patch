index 000000000..0bb930734
--- /dev/null
+++ b/src/bignum.h
@@ -0,0 +1,595 @@
+// Copyright (c) 2009-2010 Satoshi Nakamoto
+// Copyright (c) 2009-2013 The Crowncoin developers
