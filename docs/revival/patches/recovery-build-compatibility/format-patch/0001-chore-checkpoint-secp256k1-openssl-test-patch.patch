+        if(nSporkID == SPORK_9_MASTERNODE_BUDGET_ENFORCEMENT) r = SPORK_9_MASTERNODE_BUDGET_ENFORCEMENT_DEFAULT;
+        if(nSporkID == SPORK_10_MASTERNODE_DONT_PAY_OLD_NODES) r = SPORK_10_MASTERNODE_DONT_PAY_OLD_NODES_DEFAULT;
