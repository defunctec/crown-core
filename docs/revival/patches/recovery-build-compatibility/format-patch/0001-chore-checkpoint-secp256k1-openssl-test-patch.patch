+
+        std::string strProposalName = params[1].get_str();
+        if(strProposalName.size() > 20)
+            return "Invalid proposal name, limit of 20 characters.";
+
+        std::string strURL = params[2].get_str();
+        if(strURL.size() > 64)
+            return "Invalid url, limit of 64 characters.";
+
